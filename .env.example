# Copy to .env and change the values. Never commit .env.

# Postgres (app metadata DB)
POSTGRES_USER=vita
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vita

# Used by the backend (SQLAlchemy + Alembic). Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://vita:change-me@db:5432/vita

# Key used to encrypt saved connection passwords (a Fernet key). Required.
# Generate one with:
#   docker compose run --rm --no-deps backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if you change or lose it, saved connection passwords can't be decrypted
# and must be re-entered.
VITA_SECRET_KEY=

# Demo database (sampledb service). In Vita, connect with host "sampledb", port 5432.
SAMPLEDB_USER=demo
SAMPLEDB_PASSWORD=demo-pass-1234
SAMPLEDB_DB=sampledb
